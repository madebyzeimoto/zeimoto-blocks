{
  "name": "zeimoto/blocks",
  "description": "Custom Kirby blocks with Panel editors and public rendering snippets.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby6",
    "zeimoto",
    "blocks"
  ],
  "authors": [
    {
      "name": "zeimoto"
    }
  ],
  "require": {
    "php": "^8.5",
    "getkirby/cms": "^6.0@RC",
    "getkirby/composer-installer": "^1.2.1",
    "zeimoto/image": "dev-main",
    "zeimoto/writer": "dev-main"
  },
  "extra": {
    "installer-name": "zeimoto-blocks"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
